        "tenantId": "tenant_scnu",
        "studentId": "stu_demo_002",
        "sessionId": "session_demo_002",
        "role": "assistant",
        "content": "汉语言文学适合对中文、教育和文化方向感兴趣的考生，宿舍安排以学校当年通知为准。",
